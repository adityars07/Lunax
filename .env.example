# Required
OPENAI_API_KEY=your-api-key-here
TAVILY_API_KEY=tvly-...

# Optional: custom OpenAI-compatible endpoint (e.g. Groq, Google Gemini, OpenRouter)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# ROUTER_MODEL=llama-3.1-8b-instant
# SYNTH_MODEL=llama-3.3-70b-versatile
# CLAIMS_MODEL=llama-3.1-8b-instant

# Defaults (if using OpenAI directly):
ROUTER_MODEL=gpt-4o-mini
SYNTH_MODEL=gpt-4o
CLAIMS_MODEL=gpt-4o-mini

# Optional: server & db
PORT=3000
DB_PATH=./lunax.db

