# Required
OPENAI_API_KEY=your-api-key-here
TAVILY_API_KEY=tvly-...

# Optional: use any OpenAI-compatible provider (Groq, Google Gemini, OpenRouter)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Model selection (defaults work with OpenAI; override for other providers)
# Example for Groq free tier:
#   ROUTER_MODEL=qwen/qwen3.8-27b
#   SYNTH_MODEL=qwen/qwen3.8-27b
#   CLAIMS_MODEL=qwen/qwen3.8-27b
ROUTER_MODEL=gpt-4o-mini
SYNTH_MODEL=gpt-4o
CLAIMS_MODEL=gpt-4o-mini

# Optional: server & db
PORT=3000
DB_PATH=./lunax.db
